{% extends 'base.html.twig' %}

{% block title %}Détails du produit{% endblock %}

{% block body %}
<div class="container mx-auto p-6 space-y-8">
    <a href="javascript:history.back()" class="text-gray-600 text-sm hover:text-gray-800">&larr; Page Précédente</a>

    <!-- Section principale : Image + Détails -->
    <div class="flex flex-wrap md:flex-nowrap space-y-6 md:space-y-0 md:space-x-8 rtl:space-x-reverse items-start">
        <!-- Image principale + Miniatures -->
        <div class="flex-shrink-0 w-full md:w-1/3 flex flex-col items-center bg-gray-100 rounded-lg shadow-md p-4 space-y-4">
            <!-- Image principale -->
            <img src="{{ product.vehicle.Vignette }}" alt="{{ product.part.Name }}" class="rounded-lg max-w-full max-h-64">
            <!-- Miniatures -->
            <div class="flex space-x-2">
                <img src="{{ product.vehicle.Vignette }}" alt="{{ product.part.Name }}" class="w-16 h-16 object-cover border rounded-lg">
                <img src="{{ product.vehicle.Vignette }}" alt="{{ product.part.Name }}" class="w-16 h-16 object-cover border rounded-lg">
                <img src="{{ product.vehicle.Vignette }}" alt="{{ product.part.Name }}" class="w-16 h-16 object-cover border rounded-lg">
                <button class="w-16 h-16 flex items-center justify-center border rounded-lg text-gray-500 hover:bg-gray-100">
                    +
                </button>
            </div>
        </div>

        <!-- Détails produit -->
        <div class="w-full md:flex-1 space-y-4">
            <h1 class="text-4xl font-extrabold text-gray-800">{{ product.part.Name }}</h1>
            <p class="text-2xl text-customGreen font-bold">Prix : {{ product.part.Price }} €</p>
            <p class="text-lg text-gray-600">Livraison * : À partir de 1,00 €</p>
            <p class="text-lg text-gray-600">Délais de livraison estimés entre 1 et 2 jours ouvrés.</p>
            <p class="text-lg text-gray-600">Garantie : {{ product.part.Warranty }}</p>
            <div class="flex space-x-4">
                <a href="{{ path('cart_add', { id: product.part.Id }) }}" class="bg-customGreen text-white px-6 py-3 rounded-lg hover:bg-green-700 inline-block">Ajouter au panier</a>
            </div>
        </div>
    </div>

    <!-- Caractéristiques et Détails supplémentaires -->
    <div class="space-y-8">
        <!-- Caractéristiques -->
        <div>
            <h2 class="text-2xl font-bold text-gray-800 mb-4">Caractéristiques</h2>
            <table class="table-auto w-full border-collapse border border-gray-200 rounded-lg shadow-md">
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for label, value in {
                        'Référence constructeur': product.part.ManufacturerReference,
                        'Référence Opisto': product.part.Id,
                        'Dénomination de la pièce': product.part.Name,
                        'Catégorie du produit': product.part.Category,
                        'Description': product.part.Description,
                        'Prix TTC': product.part.Price ~ ' €',
                        'État de la pièce': product.part.PartType,
                        'Quantité': '1,00',
                        'Durée de garantie': product.part.Warranty
                    } %}
                    <tr>
                        <td class="px-4 py-2 font-semibold text-gray-700">{{ label }}</td>
                        <td class="px-4 py-2 text-gray-600">{{ value }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Véhicule d'origine -->
        <div>
            <h2 class="text-2xl font-bold text-gray-800 mb-4">Véhicule d'origine</h2>
            <table class="table-auto w-full border-collapse border border-gray-200 rounded-lg shadow-md">
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for label, value in {
                        'Marque du véhicule': product.vehicleBrand.Name,
                        'Gamme du véhicule': product.vehicleRange.Range,
                        'Modèle du véhicule': product.vehicleModel.Model,
                        'Finition du véhicule': product.vehicleVersion.Finish,
                        'Désignation commerciale': product.vehicleVersion.CommercialDesignation,
                        'Année de mise en circulation': product.vehicleModel.Begin,
                        'Kilométrage': product.vehicle.Mileage ~ ' km',
                        'Couleur': product.vehicle.Color,
                        'Cylindrée': product.vehicleVersion.Displacement,
                        'Puissance': product.vehicleVersion.Power ~ ' ch',
                        'Carburant': product.vehicleVersion.Energy,
                        'Type de boîte de vitesses': product.vehicleVersion.GearboxType,
                        'Code moteur': product.vehicleVersion.EngineCode,
                        'Code boîte de vitesses': product.vehicleVersion.GearboxCode,
                        'Nombre de portes': product.vehicleVersion.DoorNumber
                    } %}
                    <tr>
                        <td class="px-4 py-2 font-semibold text-gray-700">{{ label }}</td>
                        <td class="px-4 py-2 text-gray-600">{{ value }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
