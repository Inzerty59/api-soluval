{% extends 'base.html.twig' %}

{% block title %}Détails du produit{% endblock %}

{% block body %}
<div class="container mx-auto p-6 space-y-8">
    <button
        type="button"
        onclick="history.back()"
        class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-md bg-gray-200 text-gray-700
               hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-400 transition"
    >
        <!-- Petite flèche gauche (SVG) -->
        <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Page Précédente
    </button>

    <!-- Section principale : Image + Détails -->
    <div class="flex flex-wrap md:flex-nowrap space-y-6 md:space-y-0 md:space-x-8 rtl:space-x-reverse items-start">
        <!-- Image principale + Miniatures -->
        <div class="flex-shrink-0 w-full md:w-1/3 flex flex-col items-center bg-gray-100 rounded-lg shadow-md p-4 space-y-4">
            <!-- Image principale -->
            <img src="{{ part.vignette }}" alt="{{ part.getName() }}" class="rounded-lg max-w-full max-h-64">
            <!-- Miniatures -->
            <div class="flex flex-wrap space-x-2">
                {% for photo in part.photos|slice(0, 5) %}
                    <img src="{{ photo }}" alt="{{ part.getName() }}" class="w-16 h-16 object-cover border rounded-lg">
                {% endfor %}
                {% if part.photos|length > 5 %}
                    <button id="show-more-photos" class="w-16 h-16 flex items-center justify-center border rounded-lg text-gray-500 hover:bg-gray-100">
                        +
                    </button>
                {% endif %}
            </div>
            <div id="more-photos" class="hidden flex flex-wrap space-x-2 mt-2">
                {% for photo in part.photos|slice(5) %}
                    <img src="{{ photo }}" alt="{{ part.getName() }}" class="w-16 h-16 object-cover border rounded-lg">
                {% endfor %}
            </div>
        </div>

        <!-- Détails produit -->
        <div class="w-full md:flex-1 space-y-4">
            <h1 class="text-4xl font-extrabold text-gray-800">{{ part.getName() }}</h1>
            <p class="text-2xl text-customGreen font-bold">Prix : {{ part.getFinalPrice() }} €</p>
            <p class="text-lg text-gray-600">Livraison * : À partir de 1,00 €</p>
            <p class="text-lg text-gray-600">Délais de livraison estimés entre 1 et 2 jours ouvrés.</p>
            <p class="text-lg text-gray-600">Garantie : {{ part.warranty }} mois</p>
            <div class="flex space-x-4">
                <a href="{{ path('cart_add', { id: part.id }) }}" class="bg-customGreen text-white px-6 py-3 rounded-lg hover:bg-green-700 inline-block">Ajouter au panier</a>
            </div>
        </div>
    </div>

    <!-- Caractéristiques et Détails supplémentaires -->
    <div class="space-y-8">
        <!-- Caractéristiques -->
        <div>
            <h2 class="text-2xl font-bold text-gray-800 mb-4">Caractéristiques</h2>
            <table class="table-auto w-full border-collapse border border-gray-200 rounded-lg shadow-md">
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for label, value in {
                        'Référence constructeur': part.manufacturerReference,
                        'Référence Opisto': part.id,
                        'Dénomination de la pièce': part.getName(),
                        'Catégorie du produit': part.categoryName,
                        'Description': part.description,
                        'Prix TTC': part.getFinalPrice() ~ ' €',
                        'État de la pièce': part.partCondition,
                        'Quantité': '1,00',
                        'Durée de garantie': part.warranty
                    } %}
                    <tr>
                        <td class="px-4 py-2 font-semibold text-gray-700">{{ label }}</td>
                        <td class="px-4 py-2 text-gray-600">{{ value }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Véhicule d'origine -->
        <div>
            <h2 class="text-2xl font-bold text-gray-800 mb-4">Véhicule d'origine</h2>
            <table class="table-auto w-full border-collapse border border-gray-200 rounded-lg shadow-md">
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for label, value in {
                        'Marque du véhicule': part.brandName,
                        'Gamme du véhicule': part.rangeName,
                        'Modèle du véhicule': part.modelName,
                        'Finition du véhicule': part.finishName,
                        'Désignation commerciale': part.commercialDesignation,
                        'Année de mise en circulation': part.vehicleYear,
                        'Kilométrage': part.mileage ~ ' km',
                        'Couleur': part.colorName ? part.colorName|join(', ') : 'N/A',
                        'Cylindrée': part.displacement,
                        'Puissance': part.power ~ ' ch',
                        'Carburant': part.energyName,
                        'Type de boîte de vitesses': part.gearboxType ? part.gearboxType|join(', ') : 'N/A',
                        'Code moteur': part.engineCode,
                        'Code boîte de vitesses': part.gearboxCode,
                        'Nombre de portes': part.doorNumber
                    } %}
                    <tr>
                        <td class="px-4 py-2 font-semibold text-gray-700">{{ label }}</td>
                        <td class="px-4 py-2 text-gray-600">{{ value }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.getElementById('show-more-photos').addEventListener('click', function() {
        document.getElementById('more-photos').classList.toggle('hidden');
    });
</script>
{% endblock %}
