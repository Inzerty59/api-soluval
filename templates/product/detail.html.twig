{% extends 'base.html.twig' %}

{% block title %}Détails du produit{% endblock %}

{% block body %}
<div class="container mx-auto p-6 space-y-8">
    <button
        type="button"
        id="back-Description"
        onclick="history.back()"
        class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-md bg-gray-200 text-gray-700
               hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-400 transition"
    >
        <!-- Petite flèche gauche (SVG) -->
        <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Page Précédente
    </button>

    <!-- Section principale : Image + Détails -->
    <div class="flex flex-wrap md:flex-nowrap space-y-6 md:space-y-0 md:space-x-8 rtl:space-x-reverse items-start">
        <!-- Image principale + Miniatures -->
        <div class="flex-shrink-0 w-full md:w-1/3 flex flex-col items-center bg-gray-100 rounded-lg shadow-md p-4 space-y-4">
            <!-- Image principale -->
            <img src="{{ part.vignette }}" id="image_Description" alt="{{ part.getName() }}" class="rounded-lg max-w-full max-h-64">
            <!-- Miniatures -->
            <div class="flex flex-wrap space-x-2" id="miniature_Description"> 
                {% for photo in part.photos|slice(0, 5) %}
                    <img src="{{ photo }}" alt="{{ part.getName() }}" class="w-16 h-16 object-cover border rounded-lg">
                {% endfor %}
                {% if part.photos|length > 5 %}
                    <button id="show-more-photos" class="w-16 h-16 flex items-center justify-center border rounded-lg text-gray-500 hover:bg-gray-100">
                        +
                    </button>
                {% endif %}
            </div>
            <div id="more-photos" class="hidden flex flex-wrap space-x-2 mt-2">
                {% for photo in part.photos|slice(5) %}
                    <img src="{{ photo }}" alt="{{ part.getName() }}" class="w-16 h-16 object-cover border rounded-lg">
                {% endfor %}
            </div>
        </div>

        <!-- Détails produit -->
        <div class="w-full md:flex-1 space-y-4">
            <h1 class="text-4xl font-extrabold text-gray-800" id="name_Description">{{ part.getName() }}</h1>
            <p class="text-2xl text-customGreen font-bold" id="prix_Description">Prix : {{ part.getFinalPrice() }} €</p>
            <p class="text-lg text-gray-600" id="livraison_Description">Livraison * : À partir de 1,00 €</p>
            <p class="text-lg text-gray-600" id="delai_Livraison_Description">Délais de livraison estimés entre 1 et 2 jours ouvrés.</p>
            <p class="text-lg text-gray-600" id="garantie_Description">Garantie : {{ part.warranty }} mois</p>
            <div class="flex space-x-4">
                <a href="{{ path('cart_add', { id: part.id }) }}" href="{{ path('cart_add', { id: part.id }) }}" class="bg-customGreen text-white px-6 py-3 rounded-lg hover:bg-green-700 inline-block">Ajouter au panier</a>
            </div>
        </div>
    </div>

    <!-- Caractéristiques et Détails supplémentaires -->
    <div class="space-y-8">
        <!-- Caractéristiques -->
        <div>
            <h2 class="text-2xl font-bold text-gray-800 mb-4">Caractéristiques</h2>
            <table class="table-auto w-full border-collapse border border-gray-200 rounded-lg shadow-md">
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for label, value in {
                        'Référence constructeur': part.manufacturerReference|default('Non renseignée'),
                        'Référence Opisto': part.getExternalId()|default('Non renseignée'),
                        'Dénomination de la pièce': part.getName()|default('Non renseignée'),
                        'Catégorie du produit': part.categoryName|default('Non renseignée'),
                        'Description': part.description|default('Non renseignée'),
                        'Prix TTC': (part.getFinalPrice() ? part.getFinalPrice() ~ ' €' : 'Non renseignée'),
                        'État de la pièce': part.partCondition|default('Non renseignée'),
                        'Quantité': '1',
                        'Durée de garantie': (part.warranty ? part.warranty ~ ' mois' : 'Non renseignée')
                    } %}
                    <tr>
                        <td class="px-4 py-2 font-semibold text-gray-700">{{ label }}</td>
                        <td class="px-4 py-2 text-gray-600">{{ value }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Véhicule d'origine -->
        <div>
            <h2 class="text-2xl font-bold text-gray-800 mb-4">Véhicule d'origine</h2>
            <table class="table-auto w-full border-collapse border border-gray-200 rounded-lg shadow-md">
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for label, value in {
                        'Marque du véhicule': part.brandName|default('Non renseignée'),
                        'Gamme du véhicule': part.rangeName|default('Non renseignée'),
                        'Modèle du véhicule': part.modelName|default('Non renseignée'),
                        'Finition du véhicule': part.finishName|default('Non renseignée'),
                        'Désignation commerciale': part.commercialDesignation|default('Non renseignée'),
                        'Année de mise en circulation': part.vehicleYear|default('Non renseignée'),
                        'Kilométrage': (part.mileage ? part.mileage ~ ' km' : 'Non renseignée'),
                        'Couleur': part.colorName ? part.colorName|join(', ') : 'Non renseignée',
                        'Cylindrée': part.displacement|default('Non renseignée'),
                        'Puissance': (part.power ? part.power ~ ' ch' : 'Non renseignée'),
                        'Carburant': part.energyName|default('Non renseignée'),
                        'Type de boîte de vitesses': part.gearboxType ? part.gearboxType|join(', ') : 'Non renseignée',
                        'Code moteur': part.engineCode|default('Non renseignée'),
                        'Code boîte de vitesses': part.gearboxCode|default('Non renseignée'),
                        'Nombre de portes': part.doorNumber|default('Non renseignée')
                    } %}
                    <tr>
                        <td class="px-4 py-2 font-semibold text-gray-700">{{ label }}</td>
                        <td class="px-4 py-2 text-gray-600">{{ value }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.getElementById('show-more-photos').addEventListener('click', function() {
        document.getElementById('more-photos').classList.toggle('hidden');
    });
</script>
{% endblock %}
