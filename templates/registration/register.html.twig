{# templates/registration/register.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}

    {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.name) }}
        {{ form_row(registrationForm.surname) }}
        {{ form_row(registrationForm.email) }}
        {{ form_row(registrationForm.password) }}
        {{ form_row(registrationForm.accountType) }}

        {# Champs supplémentaires pour les professionnels #}
        {% if registrationForm.accountType.vars.data == 'professionnel' %}
            {{ form_row(registrationForm.companyName) }}
            {{ form_row(registrationForm.siretNumber) }}
            {{ form_row(registrationForm.vatNumber) }}
        {% endif %}

        <button type="submit">S'inscrire</button>
    {{ form_end(registrationForm) }}
{% endblock %}
