{% extends 'base.html.twig' %}

{% block body %}
	<div
		class="container mx-auto mt-6 px-4">
		<!-- Titre principal -->
		<h1 class="text-2xl font-bold text-gray-800 mb-6 text-center">Nos pièces detachées</h1>

		<!-- Conteneur principal -->
		<div
			class="flex flex-col lg:flex-row gap-6">
			<!-- Barre latérale des filtres -->
			<aside class="lg:w-1/4 bg-gray-50 p-4 shadow-md rounded">
				<h2 class="text-lg font-semibold mb-4">Filtres</h2>
				<div class="mb-4">
					<label for="marque" class="block font-semibold mb-1">Marque</label>
					<select id="marque" class="w-full border border-gray-300 p-2 rounded focus:ring-2 focus:ring-gray-300">
						<option>Toutes marques</option>
					</select>
				</div>
				<div class="mb-4">
					<label for="modele" class="block font-semibold mb-1">Modèle</label>
					<select id="modele" class="w-full border border-gray-300 p-2 rounded focus:ring-2 focus:ring-gray-300">
						<option>Tous modèles</option>
					</select>
				</div>
				<div class="mb-4">
					<label for="type-piece" class="block font-semibold mb-1">Type de pièce</label>
					<input id="type-piece" type="text" placeholder="Moteur, démarreur, turbo..." class="w-full border border-gray-300 p-2 rounded focus:ring-2 focus:ring-gray-500">
				</div>
				<button class="w-full bg-customGreen text-white p-2 rounded hover:bg-gray-500 transition">Lancer la recherche</button>
			</aside>

			<!-- Section principale -->
			<main
				class="lg:w-3/4">
				<!-- Résultats de recherche -->
				<div class="flex justify-between items-center mb-4">
					<p class="text-lg font-semibold">35 264 pièces trouvées</p>
					<div class="flex items-center gap-2">
						<button class="border border-gray-300 px-3 py-1 rounded hover:bg-gray-200">10</button>
						<button class="border border-gray-300 px-3 py-1 rounded hover:bg-gray-200">25</button>
						<button class="border border-gray-300 px-3 py-1 rounded hover:bg-gray-200">50</button>
					</div>
					<select class="border border-gray-300 p-2 rounded">
						<option>Trier par</option>
					</select>
				</div>

				<!-- Liste des produits -->
				<div class="space-y-6">
					{% for product in allData.products %}
						<div
							class="flex items-start bg-white border border-gray-300 p-4 rounded shadow-md">
							<!-- Image vignette du produit -->
							<div class="w-36 h-36 flex-shrink-0">
								<img src="{{ product.vehicle.Vignette }}" alt="{{ product.part.name }}" class="w-full h-full object-cover rounded">
							</div>

							<!-- Détails du produit -->
							<div class="flex-1 ml-4">
								<h3 class="text-lg font-semibold text-gray-800">{{ product.part.Name }}</h3>
								<p class="text-sm text-gray-500">{{ product.part.modelName }}</p>
								<p class="text-lg font-bold text-gray-800 mt-2">{{ product.part.Price }}
									€</p>
							</div>

							<!-- Bouton d'action -->
							<div>
								<button class="bg-customGreen text-white px-4 py-2 rounded hover:bg-gray-500 flex items-center gap-2">

									<svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" viewbox="0 0 24 24"><path fill="currentColor" d="M0 1h4.764l3 11h10.515l3.089-9.265l1.897.633L19.72 14H7.78l-.5 2H22v2H4.72l1.246-4.989L3.236 3H0zm14 1v3h3v2h-3v3h-2V7H9V5h3V2zM4 21a2 2 0 1 1 4 0a2 2 0 0 1-4 0m14 0a2 2 0 1 1 4 0a2 2 0 0 1-4 0"/></svg>

									Ajouter au panier
								</button>
							</div>
						</div>
					{% endfor %}
				</div>
			</main>
		</div>
	</div>
{% endblock %}
