{% extends 'base.html.twig' %}

{% block title %}
Résumé de la commande
{% endblock %}

{% block body %}
<!-- Page en pleine largeur, fond gris -->
<div class="min-h-screen bg-gray-100 p-8 text-gray-800">

    <!-- Bouton pour revenir en arrière -->
    <div class="mb-6">
        <button
            type="button"
            onclick="history.back()"
            class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-md bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-400"
        >
            <!-- Petite flèche gauche optionnelle (SVG) -->
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            Retour
        </button>
    </div>

    <!-- Titre principal -->
    <h1 class="text-2xl font-bold mb-6">Résumé de la commande</h1>

    <!-- Récapitulatif de la commande -->
    <div class="mb-8">
        <ul class="space-y-2">
            {% for item in cart %}
                <li class="flex justify-between">
                    <span>{{ item.part.getName() }}</span>
                    <span>{{ item.part.getFinalPrice() }} €</span>
                </li>
            {% endfor %}
        </ul>
        <div class="flex justify-between font-bold border-t pt-2 mt-2">
            <span>Total</span>
            <span>{{ total }} €</span>
        </div>
    </div>

    <!-- Choix du mode de livraison -->
    <div class="mb-8">
        <h2 class="text-xl font-semibold mb-2">Choix du mode de livraison</h2>
        <div class="space-y-2">
            <label class="flex items-center">
                <input type="radio" name="delivery_mode" value="comptoir" class="mr-2">
                <span>Récupérer la commande au comptoir (Gratuit)</span>
            </label>
            <label class="flex items-center">
                <input type="radio" name="delivery_mode" value="livraison" class="mr-2">
                <span>Livraison (1 à 2 jours ouvrés) à partir de 5,00 €</span>
            </label>
        </div>
    </div>

    <!-- Formulaires : adresses de livraison et de facturation -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Adresse de livraison -->
        <div>
            <h2 class="text-xl font-semibold mb-2">Adresse de livraison</h2>
            <div class="space-y-4 mb-6">
                <input type="text" class="w-full p-2 border border-gray-300 rounded" placeholder="Nom">
                <input type="text" class="w-full p-2 border border-gray-300 rounded" placeholder="Prénom">
                <input type="text" class="w-full p-2 border border-gray-300 rounded" placeholder="Téléphone">
                <input type="text" class="w-full p-2 border border-gray-300 rounded" placeholder="Adresse">
                <input type="text" class="w-full p-2 border border-gray-300 rounded" placeholder="Adresse Complémentaire">
                <input type="text" class="w-full p-2 border border-gray-300 rounded" placeholder="Ville">
                <input type="text" class="w-full p-2 border border-gray-300 rounded" placeholder="Code postal">
                <select class="w-full p-2 border border-gray-300 rounded bg-white">
                <option value="" disabled selected>Pays</option>
                <option value="DZ">Algérie</option>
                <option value="DE">Allemagne</option>
                <option value="AT">Autriche</option>
                <option value="BE">Belgique</option>
                <option value="DK">Danemark</option>
                <option value="ES">Espagne</option>
                <option value="FI">Finlande</option>
                <option value="FR">France</option>
                <option value="GP">France (Guadeloupe)</option>
                <option value="CE">France (Corse)</option>
                <option value="MQ">France (Martinique)</option>
                <option value="YT">France (Mayotte)</option>
                <option value="RE">France (Île de la Réunion)</option>
                <option value="PF">France (Polynésie Française)</option>
                <option value="BL">France (Saint-Barthélemy)</option>
                <option value="MF">France (Saint-Martin)</option>
                <option value="PM">France (Saint-Pierre-et-Miquelon)</option>
                <option value="WF">France (Wallis et Futuna)</option>
                <option value="GR">Grèce</option>
                <option value="GF">Guyane Française</option>
                <option value="IT">Italie</option>
                <option value="LU">Luxembourg</option>
                <option value="MA">Maroc</option>
                <option value="MC">Monaco</option>
                <option value="NL">Pays-Bas</option>
                <option value="NO">Norvège</option>
                <option value="PT">Portugal</option>
                <option value="SE">Suède</option>
            </select>
            </div>
        </div>

        <!-- Adresse de facturation -->
        <div>
            <h2 class="text-xl font-semibold mb-2">Adresse de facturation</h2>
            <div class="space-y-4">
                <input type="text" class="w-full p-2 border border-gray-300 rounded" placeholder="Nom">
                <input type="text" class="w-full p-2 border border-gray-300 rounded" placeholder="Prénom">
                <input type="text" class="w-full p-2 border border-gray-300 rounded" placeholder="Téléphone">
                <input type="text" class="w-full p-2 border border-gray-300 rounded" placeholder="Adresse">
                <input type="text" class="w-full p-2 border border-gray-300 rounded" placeholder="Adresse Complémentaire">
                <input type="text" class="w-full p-2 border border-gray-300 rounded" placeholder="Ville">
                <input type="text" class="w-full p-2 border border-gray-300 rounded" placeholder="Code postal">
                <select class="w-full p-2 border border-gray-300 rounded bg-white">
                <option value="" disabled selected>Pays</option>
                <option value="DZ">Algérie</option>
                <option value="DE">Allemagne</option>
                <option value="AT">Autriche</option>
                <option value="BE">Belgique</option>
                <option value="DK">Danemark</option>
                <option value="ES">Espagne</option>
                <option value="FI">Finlande</option>
                <option value="FR">France</option>
                <option value="GP">France (Guadeloupe)</option>
                <option value="CE">France (Corse)</option>
                <option value="MQ">France (Martinique)</option>
                <option value="YT">France (Mayotte)</option>
                <option value="RE">France (Île de la Réunion)</option>
                <option value="PF">France (Polynésie Française)</option>
                <option value="BL">France (Saint-Barthélemy)</option>
                <option value="MF">France (Saint-Martin)</option>
                <option value="PM">France (Saint-Pierre-et-Miquelon)</option>
                <option value="WF">France (Wallis et Futuna)</option>
                <option value="GR">Grèce</option>
                <option value="GF">Guyane Française</option>
                <option value="IT">Italie</option>
                <option value="LU">Luxembourg</option>
                <option value="MA">Maroc</option>
                <option value="MC">Monaco</option>
                <option value="NL">Pays-Bas</option>
                <option value="NO">Norvège</option>
                <option value="PT">Portugal</option>
                <option value="SE">Suède</option>
            </select>
            </div>
        </div>
    </div>

    <!-- Bouton de confirmation -->
    <div class="mt-8" style="text-align: right;">
        <form action="{{ path('orderSummary_page') }}" method="GET">
            <button class="bg-customGreen hover:bg-gray-500 text-white font-bold py-2 px-4 rounded">
                Continuer vers le paiement
            </button>
        </form>
    </div>
</div>
{% endblock %}