{% extends 'base.html.twig' %}

{% block title %}
Résumé de la commande
{% endblock %}

{% block body %}
<!-- Page entière, fond gris clair -->
<div class="min-h-screen bg-gray-50 py-6 px-8 text-gray-800">

    <!-- Bouton pour revenir en arrière -->
    <div class="mb-6">
        <button
            type="button"
            onclick="history.back()"
            class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-md bg-gray-200 text-gray-700
                   hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-400 transition"
        >
            <!-- Petite flèche gauche (SVG) -->
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            Retour
        </button>
    </div>

    <!-- Titre principal -->
    <h1 class="text-2xl font-bold mb-6">Résumé de la commande</h1>

    <!-- Tableau récapitulatif : pleine largeur, pas d'effet hover -->
    <div class="overflow-x-auto">
        <table class="w-full table-auto text-left border-collapse">
            <thead class="bg-blue-600 text-white">
                <tr>
                    <th class="px-4 py-3 font-semibold">Dénomination de la pièce</th>
                    <th class="px-4 py-3 font-semibold">Quantité</th>
                    <th class="px-4 py-3 font-semibold">Prix</th>
                    <th class="px-4 py-3 font-semibold">Mode de récupération</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
                {% for item in cart %}
                    <tr>
                        <td class="px-4 py-3">{{ item.part.getName() }}</td>
                        <td class="px-4 py-3">{{ item.quantity|default(1) }}</td>
                        <td class="px-4 py-3">{{ item.part.getFinalPrice() }} €</td>
                        <td class="px-4 py-3">Livraison</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Informations sur la livraison -->
    <p class="mt-4 text-gray-700">
        Cette commande vous sera livrée pour
        <span class="font-semibold text-gray-800">17,00 €</span>
    </p>

    <!-- Tableau des totaux -->
    <div class="mt-6 flex justify-end">
        <div class="w-full md:w-1/2 lg:w-1/3">
            <table class="w-full text-sm text-gray-700 border-collapse">
                <tbody class="divide-y divide-gray-200 bg-white rounded-md shadow-sm">
                    <tr>
                        <td class="py-3 px-4 font-medium">Total articles</td>
                        <td class="py-3 px-4 text-right">{{ total }} €</td>
                    </tr>
                    <tr>
                        <td class="py-3 px-4 font-medium">Frais de port</td>
                        <td class="py-3 px-4 text-right">17,00 €</td>
                    </tr>
                    <tr>
                        <td class="py-3 px-4 font-bold text-base">Net à payer</td>
                        <td class="py-3 px-4 font-bold text-base text-right">{{ total + 17 }} €</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Bouton pour continuer le processus de commande/paiement -->
    <div class="mt-8">
        <button
            class="bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded transition
                   focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500"
        >
            Régler la commande
        </button>
    </div>
</div>
{% endblock %}
