{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="flex justify-center items-center min-h-screen bg-gray-100">
        <div class="bg-white p-8 rounded shadow-md w-full max-w-md">
            <form method="post">
                <h1 class="text-3xl font-bold mb-6 text-center">Connectez-vous</h1>
                {% for message in app.flashes('success') %}
                    <div class="bg-green-100 border border-green-400 text-black-400 px-4 py-3 rounded mb-4 shadow-sm" role="alert">
                        {{ message }}
                    </div>
                {% endfor %}
                {% if error %}
                    <div class="bg-red-100 border border-red-400 text-black-400 px-4 py-3 rounded mb-4 shadow-sm" role="alert">Vos identifiants sont incorrects.</div>
                {% endif %}
                <div class="mb-4">
                    <label for="username" class="block font-semibold mb-1">E-mail</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" class="w-full border border-gray-300 p-2 rounded focus:ring-2 focus:ring-gray-500" autocomplete="email" required autofocus>
                </div>
                <div class="mb-4 relative">
                    <div class="flex justify-between items-center mb-1">
                        <label for="password" class="block font-semibold">Mot de passe</label>
                        <p><a href="/reinitialisation" class="text-customGreen hover:underline">Mot de passe oublié ?</a></p>
                    </div>
                    <div class="relative">
                        <input type="password" name="_password" id="password" class="w-full border border-gray-300 p-2 rounded focus:ring-2 focus:ring-gray-500" autocomplete="current-password" required>
                        <span class="absolute inset-y-0 right-0 pr-3 flex items-center cursor-pointer" onclick="togglePasswordVisibility()">
                            <svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.522 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.478 0-8.268-2.943-9.542-7z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M4.5 4.5l15 15" style="display: none;" />
                            </svg>
                        </span>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="w-full bg-customGreen text-white p-2 rounded hover:bg-gray-500 transition mt-4" type="submit">
                    Se connecter
                </button>
            </form>

            <div class="mt-4 text-center">
                <p>Pas de compte ? <a href="/inscription" class="text-customGreen hover:underline">Créer un compte</a></p>
            </div>
        </div>
    </div>
    {{ encore_entry_script_tags('togglePasswordVisibility') }}
{% endblock %}
