{% extends 'base.html.twig' %}

{% block title %}Réinitialisation du mot de passe{% endblock %}

{% block body %}
    <div class="flex justify-center items-center min-h-screen bg-gray-100">
        <div class="bg-white p-8 rounded shadow-md w-full max-w-md">
            <h1 class="text-3xl font-bold mb-6 text-center">Réinitialisation du mot de passe</h1>
            {% if emailNotFound %}
                <div class="bg-red-100 border border-red-400 text-black-400 px-4 py-3 rounded mb-4 shadow-sm" role="alert">
                    Cette adresse e-mail n'existe pas.
                </div>
            {% endif %}
            <form method="post">
                <div class="mb-4">
                    <label for="email" class="block font-semibold mb-1">E-mail</label>
                    <input type="email" name="email" id="email" class="w-full border border-gray-300 p-2 rounded focus:ring-2 focus:ring-gray-500" required autofocus>
                </div>
                <button class="w-full bg-customGreen text-white p-2 rounded hover:bg-gray-500 transition mt-4" type="submit">
                    Envoyer
                </button>
            </form>
        </div>
    </div>
{% endblock %}